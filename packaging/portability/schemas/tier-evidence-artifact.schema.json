{
  "$id": "https://zms-labs.example/portability/tier-evidence-artifact@1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_identity": {
      "minLength": 1,
      "type": "string"
    },
    "actuator_scope": {
      "minLength": 1,
      "type": "string"
    },
    "authority_identity": {
      "minLength": 1,
      "type": "string"
    },
    "authority_scope": {
      "enum": [
        "fixture-only",
        "authoritative"
      ]
    },
    "content_digest": {
      "minLength": 1,
      "type": "string"
    },
    "credential_class": {
      "minLength": 1,
      "type": "string"
    },
    "credential_digest": {
      "minLength": 1,
      "type": "string"
    },
    "decision": {
      "enum": [
        "not-applicable",
        "deny",
        "allow"
      ]
    },
    "evidence_epoch": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_payload_digest": {
      "minLength": 1,
      "type": "string"
    },
    "failure_behavior": {
      "enum": [
        "not-applicable",
        "fail-closed",
        "demote-unverified"
      ]
    },
    "failure_modes": {
      "items": {
        "enum": [
          "timeout",
          "crash",
          "malformed-output"
        ]
      },
      "type": "array"
    },
    "hook_active": {
      "type": "boolean"
    },
    "hook_config_digest": {
      "minLength": 1,
      "type": "string"
    },
    "hook_installed": {
      "type": "boolean"
    },
    "hook_trusted": {
      "type": "boolean"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "independent_acceptor_identity": {
      "minLength": 1,
      "type": "string"
    },
    "installed_package_digest": {
      "minLength": 1,
      "type": "string"
    },
    "interruption_record_id": {
      "minLength": 1,
      "type": "string"
    },
    "issuer_identity": {
      "minLength": 1,
      "type": "string"
    },
    "launcher_digest": {
      "minLength": 1,
      "type": "string"
    },
    "native_boundary_identity": {
      "minLength": 1,
      "type": "string"
    },
    "outcome": {
      "enum": [
        "failed",
        "passed",
        "unverified"
      ]
    },
    "principal_identity": {
      "minLength": 1,
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "type": "string"
    },
    "record_type": {
      "enum": [
        "installed-package-launcher-evidence@1",
        "interruption-evidence@1",
        "recovery-evidence@1",
        "actor-authority-separation@1",
        "independent-acceptance-evidence@1",
        "native-boundary-identity@1",
        "matched-deny-evidence@1",
        "neighboring-allow-evidence@1",
        "failure-behavior-evidence@1",
        "hook-configuration-evidence@1"
      ]
    },
    "recovery_record_id": {
      "minLength": 1,
      "type": "string"
    },
    "referenced_record_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "actor-authority-separation-observation",
        "custody-interruption-observation",
        "custody-recovery-observation",
        "exact-candidate-conformance-run",
        "exact-head-ci-run",
        "failure-behavior-observation",
        "hook-configuration-readback",
        "independent-acceptance-decision",
        "independent-audit-retention-readback",
        "installed-package-launcher-observation",
        "matched-deny-observation",
        "native-boundary-attestation",
        "native-stage-c-control",
        "neighboring-allow-observation",
        "operator-promotion-decision",
        "tier-independent-acceptance-verdict"
      ]
    },
    "source_record_digest": {
      "minLength": 1,
      "type": "string"
    },
    "source_statement_digest": {
      "minLength": 1,
      "type": "string"
    },
    "subject_digest": {
      "minLength": 1,
      "type": "string"
    },
    "subject_id": {
      "minLength": 1,
      "type": "string"
    },
    "subject_kind": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "record_type",
    "issuer_identity",
    "authority_scope",
    "subject_kind",
    "subject_id",
    "subject_digest",
    "evidence_epoch",
    "actor_identity",
    "authority_identity",
    "independent_acceptor_identity",
    "evidence_payload_digest",
    "referenced_record_ids",
    "outcome",
    "rationale",
    "content_digest"
  ],
  "type": "object"
}
