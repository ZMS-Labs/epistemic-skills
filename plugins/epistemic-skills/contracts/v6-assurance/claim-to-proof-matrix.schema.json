{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zms-labs.github.io/epistemic-skills/contracts/v6-assurance/claim-to-proof-matrix.schema.json",
  "title": "v6 claim-to-proof matrix",
  "description": "Machine-readable claim registry for epistemic-skills v6.0 qualification (ES6-ZI-001 / issue #191).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "program", "exact_start_sha", "generated_at", "claims"],
  "properties": {
    "schema": { "const": "claim-to-proof-matrix@1" },
    "program": { "type": "string", "minLength": 1 },
    "exact_start_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "authority",
        "subject",
        "oracle",
        "falsifier",
        "environment",
        "independence",
        "evidence_tier",
        "status",
        "release_consequence",
        "owner",
        "closure_path"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^CLM-[A-Z0-9-]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "oracle": { "type": "string", "minLength": 1 },
        "falsifier": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "independence": { "type": "string", "minLength": 1 },
        "evidence_tier": {
          "type": "string",
          "enum": ["R0", "R1", "R2", "R3", "LIMITED", "RETIRED"]
        },
        "status": {
          "type": "string",
          "enum": [
            "UNPROVED",
            "PARTIAL",
            "PROVED",
            "LIMITED",
            "RETIRED",
            "BLOCKED"
          ]
        },
        "release_consequence": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "closure_path": { "type": "string", "minLength": 1 },
        "linked_issues": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "linked_prs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "evidence_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
