{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formal-rigor-semantic-adjudication.schema.json",
  "title": "formal-rigor-semantic-adjudication@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adjudication",
    "fixture",
    "verdict",
    "obligations",
    "forbidden_propositions",
    "coverage_limits"
  ],
  "properties": {
    "adjudication": {
      "type": "string",
      "const": "formal-rigor-semantic-adjudication@1"
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["VALID", "INVALID", "INCONCLUSIVE"]
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "obligation", "status", "response_coordinates", "reason"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "obligation": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["SATISFIED", "VIOLATED", "INCONCLUSIVE"]
          },
          "response_coordinates": {
            "type": "array",
            "items": {"type": "string"}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "forbidden_propositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "proposition", "present", "response_coordinates", "reason"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "proposition": {"type": "string", "minLength": 1},
          "present": {"type": "boolean"},
          "response_coordinates": {
            "type": "array",
            "items": {"type": "string"}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage_limits": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
